[sub_resource type="GDScript" id="GDScript_oxaal"]
script/source = "extends Area2D

const cube_scene = preload(\"res://companion_cube.tscn\")

func _ready():
	body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"interactable\"):
		var spawn_pos = $\"../\".global_position
		var cube = cube_scene.instantiate()
		cube.global_position = spawn_pos
		get_tree().current_scene.add_child(cube)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_gpmsu"]
